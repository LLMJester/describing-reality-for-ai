{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runcor.ai/rpp-core/0.1/schema.json",
  "title": "R++ Core world model (v0.1)",
  "type": "object",
  "required": [
    "rpp_core",
    "system",
    "sorts",
    "fluents",
    "claims",
    "answer"
  ],
  "additionalProperties": false,
  "$defs": {
    "ident": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "var": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9_]*$",
      "not": {
        "pattern": "__"
      }
    },
    "value": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "pattern": "^([a-z][a-z0-9_]*|-?[0-9]+(\\.[0-9]+)?)$"
        }
      ]
    },
    "expr": {
      "type": "string",
      "minLength": 1
    },
    "arg": {
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "type": "string",
          "pattern": "^([a-z][a-z0-9_]*|[A-Z][A-Za-z0-9_]*|-?[0-9]+)$"
        }
      ]
    },
    "status": {
      "enum": [
        "observed",
        "asserted",
        "inferred",
        "assumed"
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "document",
            "tool",
            "human",
            "model"
          ]
        },
        "ref": {
          "type": "string"
        }
      }
    },
    "params": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ident"
      },
      "propertyNames": {
        "pattern": "^[A-Z][A-Za-z0-9_]*$",
        "not": {
          "pattern": "__"
        }
      }
    },
    "effect": {
      "type": "object",
      "required": [
        "fluent"
      ],
      "additionalProperties": false,
      "properties": {
        "fluent": {
          "$ref": "#/$defs/ident"
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/arg"
          }
        },
        "set": {
          "oneOf": [
            {
              "$ref": "#/$defs/expr"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "add": {
          "oneOf": [
            {
              "$ref": "#/$defs/expr"
            },
            {
              "type": "number"
            }
          ]
        }
      }
    },
    "law": {
      "type": "object",
      "required": [
        "id",
        "effects"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/ident"
        },
        "params": {
          "$ref": "#/$defs/params"
        },
        "when": {
          "$ref": "#/$defs/expr"
        },
        "unless": {
          "$ref": "#/$defs/expr"
        },
        "delay": {
          "type": "integer",
          "minimum": 1
        },
        "effects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/effect"
          }
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "derived": {
      "type": "object",
      "required": [
        "id",
        "fluent"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/ident"
        },
        "fluent": {
          "$ref": "#/$defs/ident"
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/arg"
          }
        },
        "params": {
          "$ref": "#/$defs/params"
        },
        "value": {
          "oneOf": [
            {
              "$ref": "#/$defs/expr"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "when": {
          "$ref": "#/$defs/expr"
        },
        "unless": {
          "$ref": "#/$defs/expr"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "constraint": {
      "type": "object",
      "required": [
        "id",
        "keyword"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/ident"
        },
        "keyword": {
          "enum": [
            "NEVER",
            "ALWAYS",
            "MUST",
            "MUST_NOT",
            "ONLY",
            "AT_MOST",
            "AT_LEAST",
            "EXACTLY",
            "BEFORE",
            "AFTER"
          ]
        },
        "params": {
          "$ref": "#/$defs/params"
        },
        "cond": {
          "$ref": "#/$defs/expr"
        },
        "if": {
          "$ref": "#/$defs/expr"
        },
        "unless": {
          "$ref": "#/$defs/expr"
        },
        "over": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9_]* in [a-z][a-z0-9_]*$"
        },
        "n": {
          "type": "integer",
          "minimum": 0
        },
        "a": {
          "$ref": "#/$defs/expr"
        },
        "b": {
          "$ref": "#/$defs/expr"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "init": {
      "type": "object",
      "required": [
        "fluent",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/ident"
        },
        "fluent": {
          "$ref": "#/$defs/ident"
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/arg"
          }
        },
        "params": {
          "$ref": "#/$defs/params"
        },
        "value": {
          "$ref": "#/$defs/value"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "decimals": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4,
      "description": "decimal places of a decimal-typed fluent/static (default 2)"
    }
  },
  "properties": {
    "rpp_core": {
      "const": "0.1"
    },
    "system": {
      "type": "string"
    },
    "horizon": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "sorts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "$ref": "#/$defs/ident"
          },
          "instances": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/ident"
            }
          },
          "range": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer"
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "statics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "$ref": "#/$defs/ident"
          },
          "args": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ident"
            }
          },
          "type": {
            "type": "string",
            "description": "int, bool, decimal (alias real/float/number), or a sort name"
          },
          "default": {
            "$ref": "#/$defs/value"
          },
          "note": {
            "type": "string"
          },
          "facts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "value"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "$ref": "#/$defs/ident"
                },
                "args": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/arg"
                  }
                },
                "value": {
                  "$ref": "#/$defs/value"
                },
                "status": {
                  "$ref": "#/$defs/status"
                },
                "source": {
                  "$ref": "#/$defs/source"
                },
                "plausible_range": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number"
                  }
                }
              }
            }
          },
          "decimals": {
            "$ref": "#/$defs/decimals"
          }
        }
      }
    },
    "fluents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "$ref": "#/$defs/ident"
          },
          "args": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ident"
            }
          },
          "type": {
            "type": "string",
            "description": "int, bool, decimal (alias real/float/number), or a sort name"
          },
          "range": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          },
          "derived": {
            "type": "boolean"
          },
          "default": {
            "$ref": "#/$defs/value"
          },
          "note": {
            "type": "string"
          },
          "decimals": {
            "$ref": "#/$defs/decimals"
          }
        }
      }
    },
    "initial": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/init"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "effects"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "$ref": "#/$defs/ident"
          },
          "params": {
            "$ref": "#/$defs/params"
          },
          "pre": {
            "$ref": "#/$defs/expr"
          },
          "effects": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/effect"
            }
          },
          "status": {
            "$ref": "#/$defs/status"
          },
          "source": {
            "$ref": "#/$defs/source"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "laws": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/law"
      }
    },
    "derived": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/derived"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/constraint"
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/ident"
          },
          "description": {
            "type": "string"
          },
          "horizon": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "init": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/init"
            }
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "action",
                "time"
              ],
              "additionalProperties": false,
              "properties": {
                "action": {
                  "$ref": "#/$defs/ident"
                },
                "args": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/value"
                  }
                },
                "time": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "interventions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "op"
              ],
              "additionalProperties": false,
              "properties": {
                "op": {
                  "enum": [
                    "set_static",
                    "disable",
                    "add_law",
                    "add_derived",
                    "add_constraint"
                  ]
                },
                "static": {
                  "$ref": "#/$defs/ident"
                },
                "args": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/value"
                  }
                },
                "value": {
                  "$ref": "#/$defs/value"
                },
                "id": {
                  "$ref": "#/$defs/ident"
                },
                "law": {
                  "$ref": "#/$defs/law"
                },
                "derived": {
                  "$ref": "#/$defs/derived"
                },
                "constraint": {
                  "$ref": "#/$defs/constraint"
                }
              }
            }
          },
          "candidate": {
            "type": "boolean"
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "about",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/ident"
          },
          "about": {
            "type": "object",
            "required": [
              "expr"
            ],
            "additionalProperties": false,
            "properties": {
              "scenario": {
                "$ref": "#/$defs/ident"
              },
              "time": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "enum": [
                      "any",
                      "all"
                    ]
                  }
                ]
              },
              "expr": {
                "$ref": "#/$defs/expr"
              }
            }
          },
          "status": {
            "$ref": "#/$defs/status"
          },
          "source": {
            "$ref": "#/$defs/source"
          },
          "derivation": {
            "type": "object",
            "required": [
              "rule"
            ],
            "additionalProperties": false,
            "properties": {
              "rule": {
                "$ref": "#/$defs/ident"
              },
              "premises": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/ident"
                }
              }
            }
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "conclusions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ident"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ident"
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ident"
            }
          }
        },
        "unexplained": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ident"
          }
        }
      }
    }
  }
}